---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";

export const prerender = false;

const token = Astro.url.searchParams.get("token") || "";
let success = false;
let errors: string[] = [];

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const newPassword = String(formData.get("newPassword") || "");
  const confirmPassword = String(formData.get("confirmPassword") || "");
  const resetToken = String(formData.get("token") || "");

  if (!newPassword || newPassword.length < 8) {
    errors.push("La contraseña debe tener al menos 8 caracteres.");
  }

  if (newPassword !== confirmPassword) {
    errors.push("Las contraseñas no coinciden.");
  }

  if (!resetToken) {
    errors.push("Token de recuperacion invalido.");
  }

  if (errors.length === 0) {
    try {
      const res = await fetch(`${Astro.url.origin}/api/auth/password-reset`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "reset", token: resetToken, newPassword }),
      });
      const data = await res.json();

      if (data.success) {
        success = true;
      } else {
        errors.push(data.error || "Error al restablecer la contraseña.");
      }
    } catch {
      errors.push("Error de conexion. Intenta de nuevo.");
    }
  }
}
---

<BaseLayout
  title="Restablecer contraseña | AverionAI"
  description="Establece una nueva contraseña para tu cuenta de AverionAI."
>
  <main class="grid min-h-screen place-items-center bg-[#07070A] px-6 py-16">
    <section class="w-full max-w-md">
      <div class="premium-panel animated-border p-7 md:p-8">
        <BrandLogo label="AverionAI" markClass="h-8 w-8" textClass="text-sm text-white/70" />

        <div class="mt-10">
          <p class="text-xs uppercase tracking-[0.18em] text-cyan-200/75">
            Nueva contraseña
          </p>

          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">
            Restablecer contraseña
          </h1>

          <p class="mt-3 text-sm leading-relaxed text-white/50">
            Introduce tu nueva contraseña. Debe tener al menos 8 caracteres.
          </p>
        </div>

        {success && (
          <div class="mt-6 rounded-xl border border-emerald-300/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
            <p>Contraseña actualizada correctamente.</p>
            <a href="/login" class="mt-2 inline-block text-cyan-200 underline">Iniciar sesion →</a>
          </div>
        )}

        {errors.length > 0 && (
          <div class="mt-6 space-y-2 rounded-xl border border-red-300/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            {errors.map((err) => (
              <p>{err}</p>
            ))}
          </div>
        )}

        {!success && (
          <form method="POST" class="mt-7 space-y-4" data-reset-form>
            <input type="hidden" name="token" value={token} />

            <label class="block space-y-2">
              <span class="text-sm text-white/65">Nueva contraseña</span>
              <input
                type="password"
                name="newPassword"
                autocomplete="new-password"
                required
                minlength="8"
                placeholder="Minimo 8 caracteres"
                class="input-premium w-full"
              />
            </label>

            <label class="block space-y-2">
              <span class="text-sm text-white/65">Confirmar contraseña</span>
              <input
                type="password"
                name="confirmPassword"
                autocomplete="new-password"
                required
                minlength="8"
                placeholder="Repite la contraseña"
                class="input-premium w-full"
              />
            </label>

            <button class="btn-primary w-full py-3.5">
              Restablecer contraseña
            </button>
          </form>
        )}

        <p class="mt-6 text-center text-sm text-white/40">
          <a href="/login" class="text-cyan-200 underline decoration-cyan-300/35 underline-offset-4 transition hover:text-white">
            Volver al login
          </a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-reset-form]");
      form?.addEventListener("submit", () => {
        const button = form.querySelector("button");
        if (button) {
          button.disabled = true;
          button.textContent = "Restableciendo...";
          button.classList.add("opacity-75");
        }
      });
    })();
  </script>
</BaseLayout>
