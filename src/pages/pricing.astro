---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SESSION_COOKIE } from "../lib/session";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = await getCurrentUser(token);
const isLoggedIn = !!user;
const isPremium = user?.isPremium === true || user?.role === "admin" || user?.role === "owner";
---

<BaseLayout title="Planes | AverionAI — Infraestructura de IA para Empresas" description="Planes de infraestructura de IA para empresas. Empieza gratis, escala con sistemas de automatizacion en produccion.">
  <Navbar />
  <main class="min-h-screen bg-[#07070A]">
    <section class="container py-20 md:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs uppercase tracking-[0.18em] text-cyan-100/70">Planes</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white md:text-6xl">
          Infraestructura de IA,<br />
          <span class="text-gradient">escalable desde el dia uno</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-white/58 md:text-base">
          Sistemas de automatizacion en produccion. Empieza con la plataforma, escala la capacidad operativa cuando lo necesites.
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-6xl gap-6 md:grid-cols-3">
        <!-- Free -->
        <div class="premium-panel p-6 md:p-8">
          <h2 class="text-2xl font-semibold text-white">Free</h2>
          <p class="mt-2 text-sm text-white/50">Explora la plataforma sin compromiso</p>
          <div class="mt-4 flex items-baseline gap-1">
            <p class="text-5xl font-bold text-white">0</p>
            <p class="text-sm text-white/40">€/mes</p>
          </div>
          <ul class="mt-8 grid gap-3 text-sm" role="list">
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> CRM con hasta 5 leads</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Panel de control basico</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> 1 automatizacion activa</li>
            <li class="flex items-start gap-3 text-white/40"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-white/10 text-[10px] text-white/40">—</span> Ebooks IA</li>
            <li class="flex items-start gap-3 text-white/40"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-white/10 text-[10px] text-white/40">—</span> Pitch decks</li>
            <li class="flex items-start gap-3 text-white/40"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-white/10 text-[10px] text-white/40">—</span> SEO Swarm</li>
          </ul>
          <div class="mt-8">
            {isLoggedIn ? (
              <a href={isPremium ? "/premium/dashboard" : "/dashboard"} class="btn-secondary w-full justify-center text-center">{isPremium ? "Ir al panel" : "Acceder gratis"}</a>
            ) : (
              <a href="/register" data-track="cta_click" data-track-label="pricing_free_empezar" class="btn-secondary w-full justify-center text-center">Empezar gratis</a>
            )}
          </div>
        </div>

        <!-- Premium -->
        <div class="premium-panel relative overflow-hidden border-cyan-300/30 bg-[linear-gradient(135deg,rgba(34,211,238,0.12),rgba(255,255,255,0.04)_48%,rgba(16,185,129,0.1))] p-6 shadow-[0_26px_95px_-58px_rgba(34,211,238,0.9)] md:p-8">
          <div class="absolute right-4 top-4 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-xs font-medium tracking-[0.12em] text-cyan-200">Recomendado</div>
          <h2 class="text-2xl font-semibold text-white">Premium</h2>
          <p class="mt-2 text-sm text-white/50">Automatizacion operativa completa</p>
          <div class="mt-4 flex items-center gap-2">
            <p class="text-5xl font-bold text-white">29</p>
            <div class="text-sm text-white/40">
              <p>€/mes</p>
              <p class="text-xs text-emerald-300/70">249€/año (ahorra 99€)</p>
            </div>
          </div>
          <ul class="mt-8 grid gap-3 text-sm" role="list">
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Leads ilimitados — sin techo de captacion</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Automatizaciones ilimitadas — escala sin limite</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Ebooks IA ilimitados — contenido automatico</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Pitch decks automaticos — propuestas en segundos</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> SEO Swarm — posicionamiento automatico</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Soporte prioritario 24/7 — respuesta &lt;4h</li>
          </ul>
          <div class="mt-8">
            {isLoggedIn && isPremium ? (
              <a href="/premium/dashboard" class="btn-primary w-full justify-center text-center">Ir al panel premium</a>
            ) : isLoggedIn ? (
              <button type="button" data-checkout-trigger="premium" data-track="cta_click" data-track-label="pricing_premium_suscribirse" class="btn-primary w-full justify-center text-center">Suscribirse ahora</button>
            ) : (
              <a href="/register" data-track="cta_click" data-track-label="pricing_premium_empezar" class="btn-primary w-full justify-center text-center">Empezar ahora</a>
            )}
          </div>
        </div>

        <!-- Business -->
        <div class="premium-panel relative overflow-hidden border-emerald-300/40 bg-[linear-gradient(135deg,rgba(16,185,129,0.12),rgba(255,255,255,0.04)_48%,rgba(34,211,238,0.08))] p-6 shadow-[0_26px_95px_-58px_rgba(16,185,129,0.9)] ring-1 ring-emerald-300/20 md:p-8">
          <div class="absolute right-4 top-4 rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-xs font-medium tracking-[0.12em] text-emerald-200">Mejor opcion</div>
          <h2 class="text-2xl font-semibold text-white">Business</h2>
          <p class="mt-2 text-sm text-white/50">Capacidad operativa para equipos</p>
          <div class="mt-4 flex items-center gap-2">
            <p class="text-5xl font-bold text-white">79</p>
            <div class="text-sm text-white/40">
              <p>€/mes</p>
              <p class="text-xs text-emerald-300/70">699€/año (ahorra 249€)</p>
            </div>
          </div>
          <ul class="mt-8 grid gap-3 text-sm" role="list">
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Todo lo de Premium — sin limites</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Usuarios multiples — equipo completo</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Roles y permisos — control de acceso</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> API publica — integracion con tus sistemas</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> Integraciones personalizadas — a tu medida</li>
            <li class="flex items-start gap-3 text-white/70"><span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-emerald-400/30 bg-emerald-400/10 text-[10px] text-emerald-300">✓</span> SLA 99.9% — soporte dedicado con ingeniero</li>
          </ul>
          <div class="mt-8">
            {isLoggedIn && isPremium ? (
              <a href="/premium/dashboard" class="btn-primary w-full justify-center text-center bg-emerald-400 hover:bg-emerald-300 text-black shadow-[0_18px_45px_-26px_rgba(16,185,129,0.9)] hover:shadow-[0_24px_70px_-28px_rgba(16,185,129,0.9)]">Ir al panel</a>
            ) : isLoggedIn ? (
              <button type="button" data-checkout-trigger="business" data-track="cta_click" data-track-label="pricing_business_elegir" class="btn-primary w-full justify-center text-center bg-emerald-400 hover:bg-emerald-300 text-black shadow-[0_18px_45px_-26px_rgba(16,185,129,0.9)] hover:shadow-[0_24px_70px_-28px_rgba(16,185,129,0.9)]">Elegir Business</button>
            ) : (
              <a href="/register" data-track="cta_click" data-track-label="pricing_business_empezar" class="btn-primary w-full justify-center text-center bg-emerald-400 hover:bg-emerald-300 text-black shadow-[0_18px_45px_-26px_rgba(16,185,129,0.9)] hover:shadow-[0_24px_70px_-28px_rgba(16,185,129,0.9)]">Empezar ahora</a>
            )}
          </div>
        </div>
      </div>

      <div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
        <div class="flex items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3">
          <span class="text-lg">🔒</span>
          <div>
            <p class="text-sm font-medium text-white">Garantia 14 dias</p>
            <p class="text-xs text-white/40">Devolucion sin preguntas</p>
          </div>
        </div>
        <div class="flex items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3">
          <span class="text-lg">⚡</span>
          <div>
            <p class="text-sm font-medium text-white">Setup en 2 min</p>
            <p class="text-xs text-white/40">Sin instalacion tecnica</p>
          </div>
        </div>
        <div class="flex items-center gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3">
          <span class="text-lg">📊</span>
          <div>
            <p class="text-sm font-medium text-white">ROI desde el mes 1</p>
            <p class="text-xs text-white/40">Ahorra 25h/mes por cada 100 leads</p>
          </div>
        </div>
      </div>

      <p class="mx-auto mt-12 max-w-xl text-center text-xs leading-relaxed text-white/38">
        Cancelacion en cualquier momento. Pago seguro procesado por Stripe. Datos cifrados en reposo y transito bajo estandares bancarios.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  (() => {
    document.querySelectorAll("[data-checkout-trigger]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const plan = btn.dataset.checkoutTrigger || "premium";
        btn.disabled = true;
        btn.textContent = "Redirigiendo...";

        try {
          const res = await fetch("/api/stripe/create-checkout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ plan }),
          });
          const data = await res.json();

          if (data.url) {
            window.location.href = data.url;
          } else {
            btn.textContent = "Error - Intenta de nuevo";
            btn.disabled = false;
          }
        } catch {
          btn.textContent = "Error de conexion";
          btn.disabled = false;
        }
      });
    });
  })();
</script>
