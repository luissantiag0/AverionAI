---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import LeadCaptureModal from "../../components/LeadCaptureModal.astro";

export const prerender = false;
---

<BaseLayout
  title="Qué es un CRM con automatización inteligente | AverionAI"
  description="Descubre qué es un CRM con IA y automatización inteligente. Diferencias con CRM tradicionales, beneficios para pymes y cómo elegir el mejor sistema para tu empresa en España."
>
  <Navbar />
  <main class="min-h-screen bg-[#07070A]">
    <section class="relative overflow-hidden border-b border-white/10 pb-20 pt-16 md:pb-28 md:pt-24">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.1),transparent_60%)]"></div>
      <div class="container">
        <div class="mx-auto max-w-3xl" data-reveal>
          <span class="badge bg-cyan-300/10 text-cyan-100">CRM Inteligente</span>
          <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">¿Qué es un CRM con automatización inteligente?</h1>
          <p class="mt-5 text-lg text-white/60">Un CRM con IA no es un simple gestor de contactos. Es un sistema operativo comercial que capta, clasifica, automatiza y cierra leads sin intervención manual.</p>
        </div>
      </div>
    </section>

    <section class="container py-16 md:py-20">
      <div class="mx-auto max-w-3xl">
        <div class="space-y-10">
          <div data-reveal>
            <h2 class="text-2xl font-semibold text-white">CRM tradicional vs CRM con IA</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5">
                <p class="text-sm font-semibold text-white/40">CRM Tradicional</p>
                <ul class="mt-3 space-y-2 text-sm text-white/50">
                  <li class="flex items-start gap-2"><span class="text-rose-300">✗</span> Gestión manual de contactos</li>
                  <li class="flex items-start gap-2"><span class="text-rose-300">✗</span> Seguimiento depende del comercial</li>
                  <li class="flex items-start gap-2"><span class="text-rose-300">✗</span> Pipeline se actualiza a mano</li>
                  <li class="flex items-start gap-2"><span class="text-rose-300">✗</span> Sin clasificación automática</li>
                  <li class="flex items-start gap-2"><span class="text-rose-300">✗</span> Reportes manuales</li>
                </ul>
              </div>
              <div class="rounded-xl border border-cyan-300/20 bg-cyan-300/[0.04] p-5">
                <p class="text-sm font-semibold text-cyan-200">CRM con IA</p>
                <ul class="mt-3 space-y-2 text-sm text-white/70">
                  <li class="flex items-start gap-2"><span class="text-emerald-300">✓</span> Captación automática de leads</li>
                  <li class="flex items-start gap-2"><span class="text-emerald-300">✓</span> Seguimiento automatizado 24/7</li>
                  <li class="flex items-start gap-2"><span class="text-emerald-300">✓</span> Pipeline se actualiza solo</li>
                  <li class="flex items-start gap-2"><span class="text-emerald-300">✓</span> Clasificación inteligente por IA</li>
                  <li class="flex items-start gap-2"><span class="text-emerald-300">✓</span> Reportes en tiempo real</li>
                </ul>
              </div>
            </div>
          </div>

          <div data-reveal>
            <h2 class="text-2xl font-semibold text-white">Características clave de un CRM inteligente</h2>
            <div class="mt-5 grid gap-4">
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5">
                <p class="text-sm font-semibold text-cyan-200">Automatización de flujos</p>
                <p class="mt-2 text-sm text-white/60">Define reglas que se ejecutan automáticamente: cuando un lead entra, se clasifica, se etiqueta y se mueve por el pipeline sin que nadie toque nada.</p>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5">
                <p class="text-sm font-semibold text-cyan-200">Clasificación con IA</p>
                <p class="mt-2 text-sm text-white/60">La inteligencia artificial analiza cada lead y determina su nivel de interés, urgencia y probabilidad de cierre. El equipo comercial solo ve los leads prioritarios.</p>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5">
                <p class="text-sm font-semibold text-cyan-200">Pipeline autónomo</p>
                <p class="mt-2 text-sm text-white/60">El pipeline se actualiza solo. Los leads avanzan de etapa según su interacción, sin necesidad de arrastrar tarjetas manualmente.</p>
              </div>
            </div>
          </div>

          <div data-reveal class="rounded-2xl border border-cyan-300/20 bg-cyan-300/[0.04] p-6">
            <h2 class="text-xl font-semibold text-white">Prueba el CRM con IA de AverionAI</h2>
            <p class="mt-3 text-sm text-white/60">Automatización inteligente para pymes españolas. Configura tu CRM en minutos.</p>
            <div class="mt-6 flex gap-4">
              <a href="/register" class="btn-primary px-6 py-2.5 text-sm">Empezar gratis</a>
              <button type="button" data-open-lead-modal class="btn-secondary px-6 py-2.5 text-sm">Solicitar demo</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-white/10 bg-white/[0.02] py-20">
      <div class="container text-center">
        <h2 class="text-3xl font-semibold text-white md:text-4xl">Prueba AverionAI gratis</h2>
        <p class="mt-4 text-white/60">24 horas de acceso premium. Sin tarjeta.</p>
        <a href="/register" class="btn-primary mt-8 px-8 py-3 inline-flex">Empezar ahora</a>
      </div>
    </section>
  </main>
  <Footer />
  <LeadCaptureModal />
</BaseLayout>
