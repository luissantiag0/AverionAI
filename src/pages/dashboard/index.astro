---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getTrialRemainingMs } from "../../lib/auth";
import { getUserLeadCounts, getUserRecentActivity } from "../../lib/crm";
import { getUserAutomationStats } from "../../lib/automations";
import OnboardingTour from "../../components/OnboardingTour.astro";
import ActivationChecklist from "../../components/ActivationChecklist.astro";

export const prerender = false;

const user = Astro.locals.user;
const trialRemaining = getTrialRemainingMs(user);
const trialHours = Math.floor(trialRemaining / 3600000);
const trialMinutes = Math.floor((trialRemaining % 3600000) / 60000);
const isTrialActive = trialRemaining > 0;

const counts = user ? await getUserLeadCounts(user.id) : null;
const isNewUser = counts?.total === 0;
const totalLeads = counts?.total ?? 0;
const FREE_LEAD_LIMIT = 5;

const recentActivity = user ? await getUserRecentActivity(user.id, 5) : [];
const hasRecentChanges = recentActivity.length > 0;
const justCreatedFirstLead = totalLeads === 1;
const autoStats = user ? await getUserAutomationStats(user.id) : null;
const hasAutomations = (autoStats?.total ?? 0) > 0;
---

<DashboardLayout title="Dashboard">
  <section class="rounded-2xl border border-white/10 bg-[linear-gradient(135deg,rgba(34,211,238,0.1),rgba(255,255,255,0.035)_48%,rgba(16,185,129,0.09))] p-6 shadow-[0_24px_90px_-54px_rgba(34,211,238,0.85)] md:p-8">
    <p class="text-xs uppercase tracking-[0.18em] text-cyan-100/70">
      Panel de control
    </p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-5xl">
      Bienvenido{user?.name ? `, ${user.name}` : ""}
    </h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-white/58 md:text-base">
      Gestiona tus leads, revisa metricas y automatiza tus procesos desde un panel seguro.
    </p>
  </section>

  {isTrialActive && (
    <section class="mt-6">
      <div class="rounded-2xl border border-cyan-300/20 bg-cyan-300/5 px-5 py-4 shadow-[0_0_30px_-12px_rgba(34,211,238,0.4)]">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-cyan-300/30 bg-cyan-300/10 text-sm">⏱</span>
            <div>
              <p class="text-sm font-medium text-cyan-100">Prueba gratuita activa</p>
              <p class="text-xs text-white/50">
                {trialHours > 0 ? `${trialHours}h ` : ""}{trialMinutes}min restantes — desbloquea todas las funciones al hacer upgrade
              </p>
            </div>
          </div>
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="trial_banner" class="btn-secondary px-4 py-2 text-xs">Ir a Premium</a>
        </div>
      </div>
    </section>
  )}

  {!isTrialActive && !user?.isPremium && (
    <section class="mt-6">
      <div class="rounded-2xl border border-amber-300/20 bg-amber-500/5 px-5 py-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-amber-100">Tu prueba gratuita termino</p>
            <p class="text-xs text-white/50">Suscribete a Premium para seguir usando todas las funcionalidades y desbloquear Ebooks, Pitch decks y SEO.</p>
          </div>
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="trial_expired_banner" class="btn-primary px-4 py-2 text-xs">Suscribirse ahora</a>
        </div>
      </div>
    </section>
  )}

  {totalLeads >= FREE_LEAD_LIMIT && !user?.isPremium && (
    <section class="mt-6">
      <div class="rounded-2xl border border-amber-300/20 bg-amber-500/5 px-5 py-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-amber-100">{totalLeads} leads creados</p>
            <p class="text-xs text-white/50">Has alcanzado el limite de leads en el plan gratuito. Actualiza a Premium para leads ilimitados + Ebooks, Pitch decks y SEO.</p>
          </div>
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="lead_limit_reached" class="btn-primary px-4 py-2 text-xs">Actualizar a Premium</a>
        </div>
      </div>
    </section>
  )}

  {totalLeads > 0 && totalLeads < FREE_LEAD_LIMIT && !user?.isPremium && (
    <section class="mt-6">
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] px-5 py-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="flex-1">
              <p class="text-sm text-white/70">
                <span class="text-white font-medium">{totalLeads}</span> de <span class="text-white font-medium">{FREE_LEAD_LIMIT}</span> leads en el plan gratuito
              </p>
              <div class="mt-2 h-1.5 w-48 max-w-full overflow-hidden rounded-full bg-white/10">
                <span class="block h-full rounded-full bg-gradient-to-r from-cyan-300 to-emerald-300" style={`width: ${(totalLeads / FREE_LEAD_LIMIT) * 100}%`}></span>
              </div>
            </div>
          </div>
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="lead_limit_progress" class="btn-secondary px-4 py-2 text-xs">Premium ilimitado</a>
        </div>
      </div>
    </section>
  )}

  <OnboardingTour show={isNewUser} />

  {isNewUser && (
    <ActivationChecklist totalLeads={counts?.total ?? 0} />
  )}

  {justCreatedFirstLead && !hasAutomations && (
    <section class="mt-6">
      <div class="rounded-2xl border border-emerald-300/15 bg-emerald-300/[0.04] px-6 py-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl border border-emerald-300/20 bg-emerald-300/10 text-2xl">🎉</span>
            <div>
              <p class="text-base font-semibold text-emerald-100">Primer lead creado</p>
              <p class="mt-0.5 text-sm text-white/50">Buen comienzo. Ahora automatiza el seguimiento para no perder oportunidades.</p>
            </div>
          </div>
          <a href="/dashboard/automations" class="btn-secondary px-5 py-2.5 text-sm shrink-0">Crear automatizacion</a>
        </div>
      </div>
    </section>
  )}

  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="premium-panel p-5">
      <p class="text-sm text-white/45">Leads totales</p>
      <p class="mt-3 text-3xl font-semibold text-white">{counts?.total ?? 0}</p>
      {!user?.isPremium && totalLeads >= FREE_LEAD_LIMIT && <p class="mt-1 text-xs text-amber-200">Limite gratuito</p>}
    </div>
    <div class="premium-panel p-5">
      <p class="text-sm text-white/45">Este mes</p>
      <p class="mt-3 text-3xl font-semibold text-cyan-100">{counts?.thisMonth ?? 0}</p>
    </div>
    <div class="premium-panel p-5">
      <p class="text-sm text-white/45">Ganados</p>
      <p class="mt-3 text-3xl font-semibold text-emerald-100">{counts?.ganados ?? 0}</p>
    </div>
    <div class="premium-panel p-5">
      <p class="text-sm text-white/45">Conversion</p>
      <p class="mt-3 text-3xl font-semibold text-purple-100">{counts?.conversion ?? 0}%</p>
    </div>
  </section>

  {autoStats && autoStats.total > 0 && (
    <section class="mt-4 grid gap-4 sm:grid-cols-4">
      <div class="premium-panel p-5">
        <p class="text-xs text-white/45 uppercase tracking-wider">🤖 Automatizaciones</p>
        <p class="mt-2 text-2xl font-semibold text-cyan-100">{autoStats.active}/{autoStats.total}</p>
        <p class="text-xs text-white/40">activas</p>
      </div>
      <div class="premium-panel p-5">
        <p class="text-xs text-white/45 uppercase tracking-wider">⚙️ Ejecuciones hoy</p>
        <p class="mt-2 text-2xl font-semibold text-emerald-100">{autoStats.executionsToday}</p>
        <p class="text-xs text-white/40">{autoStats.successToday} exitosas</p>
      </div>
      <div class="premium-panel p-5">
        <p class="text-xs text-white/45 uppercase tracking-wider">📊 Tasa de exito</p>
        <p class="mt-2 text-2xl font-semibold text-purple-100">{autoStats.executionsToday > 0 ? Math.round((autoStats.successToday / autoStats.executionsToday) * 100) : 0}%</p>
      </div>
      <div class="premium-panel p-5 border-cyan-300/10">
        <p class="text-xs text-white/45 uppercase tracking-wider">🔧 Lo que el sistema hizo</p>
        <p class="mt-2 text-sm text-white/70">{autoStats.active > 0 ? `${autoStats.active} automatizaciones procesando leads en segundo plano` : "Crea automatizaciones para que el sistema trabaje solo"}</p>
        <a href="/dashboard/automations" class="mt-2 inline-block text-xs text-cyan-200 hover:text-white transition">Gestionar automatizaciones →</a>
      </div>
    </section>
  )}

  {(hasRecentChanges || (autoStats?.recentExecutions?.length ?? 0) > 0) && (
    <section class="mt-6">
      <div class="premium-panel p-5 md:p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-300/20 bg-cyan-300/10 text-sm">📋</span>
          <div>
            <h2 class="text-base font-semibold text-white">Actividad reciente</h2>
            <p class="text-xs text-white/45">Lo que ha pasado en tu cuenta</p>
          </div>
        </div>
        <div class="mt-4 grid gap-2">
          {autoStats && autoStats.executionsToday > 0 && (
            <div class="rounded-xl border border-emerald-300/10 bg-emerald-300/[0.03] px-4 py-3">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm text-emerald-200/90">⚙️ Sistema — {autoStats.executionsToday} automatizaciones ejecutadas hoy</p>
                  <p class="text-xs text-white/40 mt-0.5">{autoStats.successToday} exitosas · {autoStats.executionsToday - autoStats.successToday} fallos</p>
                </div>
                <span class="text-xs text-emerald-200/60">{Math.round((autoStats.successToday / Math.max(autoStats.executionsToday, 1)) * 100)}% exito</span>
              </div>
            </div>
          )}
          {recentActivity.map((lead) => (
            <a href={`/dashboard/leads/${lead.id}`} class="flex items-center justify-between rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3 transition hover:border-cyan-300/20 hover:bg-white/[0.04]">
              <div class="min-w-0">
                <p class="text-sm text-white/80 truncate">{lead.name}</p>
                <p class="text-xs text-white/40">{lead.email} {lead.company ? `· ${lead.company}` : ""}</p>
              </div>
              <span class="shrink-0 text-xs text-white/35">{lead.updatedAt.toLocaleDateString("es-ES", { day: "numeric", month: "short" })}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {totalLeads > 0 && !hasAutomations && (
    <section class="mt-6">
      <div class="premium-panel p-5 md:p-6 border-cyan-300/10">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-base font-semibold text-white">Automatiza tu flujo de leads</h2>
            <p class="text-sm text-white/45 mt-0.5">Crea una automatizacion para que los leads se clasifiquen solos al entrar.</p>
          </div>
          <a href="/dashboard/automations" class="btn-secondary px-5 py-2.5 text-sm shrink-0">Configurar automatizacion</a>
        </div>
      </div>
    </section>
  )}

  <section class="mt-8 grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
    <div class="premium-panel p-5 md:p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-white">Acceso rapido</h2>
          <p class="mt-1 text-sm text-white/45">Herramientas principales</p>
        </div>
      </div>
      <div class="mt-5 grid gap-3">
        <a href="/dashboard/leads" class="rounded-2xl border border-white/10 bg-black/20 p-4 transition duration-300 hover:border-cyan-300/30 hover:bg-white/[0.055]">
          <p class="font-medium text-white">CRM / Leads</p>
          <p class="mt-1 text-sm text-white/45">Gestiona tus contactos, añade notas y cambia estados.</p>
        </a>
        <a href="/dashboard/reports" class="rounded-2xl border border-white/10 bg-black/20 p-4 transition duration-300 hover:border-cyan-300/30 hover:bg-white/[0.055]">
          <p class="font-medium text-white">Informes</p>
          <p class="mt-1 text-sm text-white/45">Revisa metricas de rendimiento y actividad.</p>
        </a>
        <a href="/dashboard/settings" class="rounded-2xl border border-white/10 bg-black/20 p-4 transition duration-300 hover:border-cyan-300/30 hover:bg-white/[0.055]">
          <p class="font-medium text-white">Ajustes</p>
          <p class="mt-1 text-sm text-white/45">Configura tu cuenta y preferencias.</p>
        </a>
      </div>
    </div>

    <div class="premium-panel p-5 md:p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-white">Estado de leads</h2>
        {!user?.isPremium && totalLeads > 0 && (
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="sidebar_premium" class="text-xs text-cyan-200 hover:text-white transition">Premium →</a>
        )}
      </div>
      <div class="mt-5 grid gap-3">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 text-sm">
          <span class="text-white/62">Activos</span>
          <span class="text-white">{counts?.activos ?? 0}</span>
        </div>
        <div class="flex items-center justify-between border-b border-white/10 pb-3 text-sm">
          <span class="text-white/62">Ganados</span>
          <span class="text-emerald-200">{counts?.ganados ?? 0}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-white/62">Totales</span>
          <span class="text-cyan-200">{counts?.total ?? 0}</span>
        </div>
      </div>
    </div>
  </section>

  {!user?.isPremium && totalLeads > 0 && (
    <section class="mt-6">
      <div class="premium-panel p-5 md:p-6 border-cyan-300/20">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-lg font-semibold text-white">Funciones bloqueadas en el plan gratuito</h2>
            <p class="mt-1 text-sm text-white/45">Actualiza a Premium y desbloquea todo el potencial de AverionAI.</p>
          </div>
          <a href="/upgrade" data-track="upgrade_prompt" data-track-label="locked_features_card" class="btn-primary px-5 py-2.5 text-sm shrink-0">Actualizar a Premium — 29€/mes</a>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <p class="text-sm font-medium text-white/40">📄 Ebooks IA</p>
            <p class="mt-1 text-xs text-white/35">Genera documentos automaticamente con IA</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <p class="text-sm font-medium text-white/40">📊 Pitch decks</p>
            <p class="mt-1 text-xs text-white/35">Presentaciones comerciales en segundos</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <p class="text-sm font-medium text-white/40">🔍 SEO Swarm</p>
            <p class="mt-1 text-xs text-white/35">Auditoria y optimizacion SEO automatica</p>
          </div>
        </div>
      </div>
    </section>
  )}

  {counts && totalLeads > 0 && (
    <section class="mt-8 premium-panel p-5 md:p-6">
      <h2 class="text-xl font-semibold text-white">Logros</h2>
      <div class="mt-5 flex flex-wrap gap-4">
        {totalLeads >= 1 && <span class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-xs text-cyan-200 icon-pulse-soft">🔰 Primer lead</span>}
        {counts.ganados >= 1 && <span class="rounded-full border border-emerald-300/20 bg-emerald-300/10 px-4 py-2 text-xs text-emerald-200 icon-pulse-soft" style="animation-delay:0.5s">🏆 Primer cliente</span>}
        {totalLeads >= 10 && <span class="rounded-full border border-purple-300/20 bg-purple-300/10 px-4 py-2 text-xs text-purple-200">💎 10 leads</span>}
        {counts.ganados >= 5 && <span class="rounded-full border border-amber-300/20 bg-amber-300/10 px-4 py-2 text-xs text-amber-200">⭐ 5 ventas</span>}
        {totalLeads === 0 && <span class="text-sm text-white/40">Crea tu primer lead para desbloquear logros →</span>}
      </div>
    </section>
  )}
</DashboardLayout>
