---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
export const prerender = false;

const triggers = [
  { id: "lead.created", label: "Cuando se crea un lead" },
  { id: "lead.stage", label: "Cuando un lead cambia de etapa" },
  { id: "lead.inactive", label: "Cuando un lead esta inactivo X dias" },
  { id: "doc.generated", label: "Cuando se genera un documento" },
  { id: "lead.won", label: "Lead marcado como ganado" },
  { id: "lead.lost", label: "Lead marcado como perdido" },
  { id: "doc.signed", label: "Documento firmado" },
  { id: "custom.event", label: "Evento personalizado" },
];

const actions = [
  { id: "email.send", label: "Enviar email automatico" },
  { id: "ai.classify", label: "Clasificar lead con IA" },
  { id: "lead.move", label: "Mover lead a otra etapa" },
  { id: "doc.auto", label: "Generar documento automatico" },
  { id: "note.auto", label: "Anadir nota automatica" },
  { id: "whatsapp.send", label: "Enviar WhatsApp automatico" },
  { id: "gmail.send", label: "Enviar email Gmail automatico" },
  { id: "webhook.send", label: "Enviar webhook" },
  { id: "task.create", label: "Crear tarea interna" },
  { id: "tag.add", label: "Anadir etiqueta al lead" },
];

const templates = [
  { name: "Respuesta automatica a leads", trigger: "lead.created", triggerLabel: "Cuando se crea un lead", actions: [{ type: "ai.classify", label: "Clasificar con IA" }, { type: "tag.add", label: "Anadir etiqueta" }], impact: "Responde a cada lead en <2 min sin intervencion manual. Aumenta tasa de contacto inicial un 40%.", icon: "⚡" },
  { name: "Cualificacion y seguimiento", trigger: "lead.status_changed", triggerLabel: "Lead marcado como cualificado", triggerConfig: '{"to":"cualificado"}', actions: [{ type: "lead.move", label: "Mover a contactado" }, { type: "note.add", label: "Anadir nota automatica" }], impact: "Mueve leads cualificados automaticamente a la siguiente etapa. Reduce tiempo de ciclo comercial un 25%.", icon: "🎯" },
  { name: "Pipeline inteligente", trigger: "lead.status_changed", triggerLabel: "Lead cambia a contactado", triggerConfig: '{"to":"contactado"}', actions: [{ type: "tag.add", label: "Etiquetar lead activo" }, { type: "note.add", label: "Registrar cambio de etapa" }], impact: "Pipeline siempre actualizado sin arrastrar estados manualmente. Evita leads olvidados.", icon: "📊" },
  { name: "Lead scoring automatico", trigger: "lead.created", triggerLabel: "Cuando se crea un lead", actions: [{ type: "ai.classify", label: "Clasificar prioridad" }, { type: "tag.add", label: "Puntuar lead" }], impact: "Cada lead recibe una puntuacion automatica. El equipo comercial solo trabaja los leads calientes.", icon: "🏆" },
  { name: "Cierre automatizado", trigger: "lead.status_changed", triggerLabel: "Lead ganado", triggerConfig: '{"to":"ganado"}', actions: [{ type: "note.add", label: "Registrar cierre" }, { type: "tag.add", label: "Marcar como ganado" }], impact: "Cuando un lead se convierte en cliente, el sistema lo registra y notifica automaticamente. Sin tareas manuales.", icon: "✅" },
];
---

<DashboardLayout title="Automatizaciones">
  <section class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6 md:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.18em] text-cyan-100/70">Workflows</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">Automatizaciones avanzadas</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/55">Crea reglas con multiples acciones que se ejecutan automaticamente.</p>
      </div>
      <button id="new-auto-btn" class="btn-primary shrink-0 px-5 py-3 text-sm text-center">+ Crear automatizacion</button>
    </div>
  </section>

  <section class="mt-8 grid gap-6 xl:grid-cols-2">
    <div class="premium-panel p-5 md:p-6">
      <h2 class="text-xl font-semibold text-white">Plantillas en produccion</h2>
      <p class="mt-1 text-sm text-white/45">Preconfiguradas con impacto real. Un clic y estan activas.</p>
      <div class="mt-5 grid gap-3">
        {templates.map((t, i) => (
          <button class="use-template group flex flex-col rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3 text-left transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-300/20 hover:bg-white/[0.04]" data-reveal data-delay={i * 40} data-template={i}>
            <div class="flex items-center gap-3">
              <span class="text-base shrink-0">{t.icon}</span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-white">{t.name}</p>
                <p class="mt-0.5 text-[11px] text-white/40">{t.triggerLabel} → {t.actions.map(a => a.label).join(" + ")}</p>
              </div>
              <span class="rounded-lg border border-white/[0.08] bg-white/[0.03] px-2 py-1 text-[10px] text-cyan-200/70 shrink-0">+ Activar</span>
            </div>
            <p class="mt-2 text-[11px] leading-relaxed text-emerald-200/60">{t.impact}</p>
          </button>
        ))}
      </div>
    </div>

    <div class="premium-panel p-5 md:p-6">
      <h2 class="text-xl font-semibold text-white">Tus automatizaciones</h2>
      <div id="auto-list" class="mt-5 grid gap-3"></div>
      <div class="mt-4 border-t border-white/10 pt-4">
        <p class="text-xs text-white/30 text-center">
          <a href="/referrals" class="text-cyan-200/50 hover:text-cyan-200 transition">Invita a otra empresa → desbloquea automatizaciones ilimitadas</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mt-8 premium-panel p-5 md:p-6">
    <h2 class="text-xl font-semibold text-white">Registro de actividad del sistema</h2>
    <p class="mt-1 text-sm text-white/45">Cada ejecucion de automatizacion se registra aqui.</p>
    <div id="execution-logs" class="mt-5 grid gap-2">
      <p class="text-sm text-white/40">Cargando ejecuciones...</p>
    </div>
  </section>

  <div id="auto-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-lg rounded-2xl border border-white/[0.08] bg-[#07070A] p-6 shadow-[0_40px_100px_-40px_rgba(34,211,238,0.3)] md:p-8">
      <div class="flex items-center justify-between mb-6"><h3 class="text-xl font-semibold text-white">Nueva automatizacion</h3><button class="close-modal text-white/30 hover:text-white/60"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button></div>
      <div class="space-y-4">
        <div><label class="text-sm text-white/60 mb-2 block">Cuando ocurre</label><select id="modal-trigger" class="input-premium w-full">{triggers.map((t) => <option value={t.id}>{t.label}</option>)}</select></div>
        <div class="flex justify-center"><svg class="h-5 w-5 text-cyan-300/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg></div>
        <div><label class="text-sm text-white/60 mb-2 block">Entonces hacer (puedes anadir varias)</label><select id="modal-action" class="input-premium w-full">{actions.map((a) => <option value={a.id}>{a.label}</option>)}</select></div>
        <button id="add-action-btn" class="text-xs text-cyan-200 hover:text-white transition">+ Anadir otra accion</button>
        <div id="actions-list" class="grid gap-2"></div>
        <div class="flex items-center gap-3 pt-2">
          <button id="save-auto" class="flex-1 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-black transition-all duration-300 hover:-translate-y-0.5">Crear automatizacion</button>
          <button id="toggle-auto" class="flex-1 rounded-xl border border-white/15 bg-white/[0.02] px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5">Activar</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  (() => {
    let selectedActions = [];
    let automations = [];

    const TEMPLATE_DATA = [
      { triggerType: "lead.created", triggerConfig: null, actions: [{ actionType: "ai.classify", order: 0 }, { actionType: "tag.add", config: '{"tag":"auto-respondido"}', order: 1 }] },
      { triggerType: "lead.status_changed", triggerConfig: '{"to":"cualificado"}', actions: [{ actionType: "lead.move", config: '{"targetStatus":"contactado"}', order: 0 }, { actionType: "note.add", config: '{"text":"Lead cualificado y movido automaticamente a seguimiento"}', order: 1 }] },
      { triggerType: "lead.status_changed", triggerConfig: '{"to":"contactado"}', actions: [{ actionType: "tag.add", config: '{"tag":"activo-auto"}', order: 0 }, { actionType: "note.add", config: '{"text":"Pipeline actualizado automaticamente"}', order: 1 }] },
      { triggerType: "lead.created", triggerConfig: null, actions: [{ actionType: "ai.classify", config: null, order: 0 }, { actionType: "tag.add", config: '{"tag":"scored-auto"}', order: 1 }] },
      { triggerType: "lead.status_changed", triggerConfig: '{"to":"ganado"}', actions: [{ actionType: "note.add", config: '{"text":"¡Lead ganado! Cerrado automaticamente por el sistema"}', order: 0 }, { actionType: "tag.add", config: '{"tag":"cerrado-auto"}', order: 1 }] },
    ];

    async function fetchAutos() {
      try {
        const res = await fetch("/api/automations");
        if (!res.ok) return;
        automations = await res.json();
        renderAutos();
      } catch { automations = []; renderAutos(); }
    }

    async function fetchLogs() {
      const container = document.getElementById("execution-logs");
      if (!container) return;
      try {
        const res = await fetch("/api/automations?stats=true");
        if (!res.ok) { container.innerHTML = '<p class="text-sm text-white/40">Sin ejecuciones recientes.</p>'; return; }
        const stats = await res.json();
        if (!stats.recentExecutions || stats.recentExecutions.length === 0) {
          container.innerHTML = '<p class="text-sm text-white/40">Aun no hay ejecuciones. Crea leads para ver el sistema en accion.</p>';
          return;
        }
        container.innerHTML = stats.recentExecutions.map((e) => {
          const isOk = e.status === "success";
          const timeAgo = timeSince(new Date(e.startedAt));
          return `<div class="flex items-center gap-4 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold ${isOk ? "bg-emerald-400/20 text-emerald-300" : "bg-red-400/20 text-red-300"}">${isOk ? "OK" : "!"}</span><div class="flex-1 min-w-0"><p class="text-sm text-white/80 truncate">${e.automation?.name || e.triggeredBy || "Automatizacion"} ejecutada</p><p class="text-xs text-white/35">${e.triggeredBy || ""} — ${timeAgo}</p></div><span class="text-[11px] font-medium px-2 py-0.5 rounded-full ${isOk ? "text-emerald-300 bg-emerald-300/10" : "text-red-300 bg-red-300/10"}">${isOk ? "Exito" : "Error"}</span></div>`;
        }).join("");
      } catch { container.innerHTML = '<p class="text-sm text-white/40">Error al cargar ejecuciones.</p>'; }
    }

    function timeSince(date) {
      const sec = Math.floor((Date.now() - date.getTime()) / 1000);
      if (sec < 60) return "Ahora";
      const min = Math.floor(sec / 60);
      if (min < 60) return `Hace ${min} min`;
      const h = Math.floor(min / 60);
      if (h < 24) return `Hace ${h} h`;
      const d = Math.floor(h / 24);
      return `Hace ${d} d`;
    }

    function renderAutos() {
      const list = document.getElementById("auto-list");
      if (!list) return;
      if (automations.length === 0) { list.innerHTML = '<p class="text-sm text-white/40">Sin automatizaciones creadas.</p>'; return; }
      list.innerHTML = automations.map((a) => {
        const triggerLabel = document.getElementById("modal-trigger")?.querySelector(`option[value="${a.triggerType}"]`)?.textContent || a.triggerType;
        const actionLabels = a.actions?.map((act) => {
          const opt = document.getElementById("modal-action")?.querySelector(`option[value="${act.actionType}"]`);
          return opt ? opt.textContent : act.actionType;
        }).join(", ") || "";
        return `<div class="flex items-center justify-between rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3 transition hover:border-white/10"><div><p class="text-sm text-white/80">${triggerLabel} <span class="text-white/30">→</span> ${actionLabels}</p><p class="text-xs text-white/40 mt-0.5">${a.active ? "Activa" : "Inactiva"}</p></div><div class="flex gap-2"><button class="toggle-auto text-xs text-cyan-200 hover:text-white transition" data-id="${a.id}">${a.active ? "Desactivar" : "Activar"}</button><button class="del-auto text-xs text-red-300 hover:text-red-100 transition" data-id="${a.id}">Eliminar</button></div></div>`;
      }).join("");

      document.querySelectorAll(".toggle-auto").forEach((b) => b.addEventListener("click", async () => {
        await fetch(`/api/automations/${b.dataset.id}`, { method: "PATCH" });
        await fetchAutos();
      }));
      document.querySelectorAll(".del-auto").forEach((b) => b.addEventListener("click", async () => {
        await fetch(`/api/automations/${b.dataset.id}`, { method: "DELETE" });
        await fetchAutos();
      }));
    }

    document.querySelectorAll(".use-template").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const idx = parseInt(btn.dataset.template);
        const tpl = TEMPLATE_DATA[idx];
        if (!tpl) return;
        try {
          await fetch("/api/automations", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: btn.querySelector("p")?.textContent?.trim() || "Plantilla",
              triggerType: tpl.triggerType,
              triggerConfig: tpl.triggerConfig,
              actions: tpl.actions,
            }),
          });
          await fetchAutos();
        } catch {}
      });
    });

    document.getElementById("new-auto-btn")?.addEventListener("click", () => {
      selectedActions = [];
      document.getElementById("actions-list").innerHTML = "";
      document.getElementById("auto-modal")?.classList.remove("hidden", "flex") || document.getElementById("auto-modal")?.classList.add("flex");
    });

    document.querySelectorAll(".close-modal").forEach((b) => b.addEventListener("click", () => b.closest("[id$=-modal]")?.classList.add("hidden")));

    document.getElementById("add-action-btn")?.addEventListener("click", () => {
      const sel = document.getElementById("modal-action");
      if (!sel) return;
      const label = sel.options[sel.selectedIndex]?.text || "";
      selectedActions.push(label);
      const list = document.getElementById("actions-list");
      if (list) list.innerHTML = selectedActions.map((a) => `<span class="inline-flex items-center gap-1 rounded-lg border border-emerald-300/20 bg-emerald-300/[0.06] px-2.5 py-1 text-[11px] text-emerald-200/80">${a}</span>`).join(" ");
    });

    document.getElementById("save-auto")?.addEventListener("click", async () => {
      const triggerSel = document.getElementById("modal-trigger");
      const actionSel = document.getElementById("modal-action");
      if (!triggerSel || !actionSel) return;
      const triggerVal = triggerSel.value;
      const actionVal = actionSel.value;
      if (!triggerVal) return;
      try {
        await fetch("/api/automations", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: triggerSel.options[triggerSel.selectedIndex]?.text || triggerVal,
            triggerType: triggerVal,
            actions: selectedActions.length ? selectedActions.map((a, i) => {
              let foundVal = actionVal;
              for (const opt of actionSel.options) { if (opt.textContent === a) { foundVal = opt.value; break; } }
              return { actionType: foundVal, order: i };
            }) : [{ actionType: actionVal, order: 0 }],
          }),
        });
        await fetchAutos();
        document.getElementById("auto-modal")?.classList.add("hidden");
      } catch {}
      selectedActions = [];
      document.getElementById("actions-list").innerHTML = "";
    });

    fetchAutos();
    fetchLogs();
  })();
</script>
