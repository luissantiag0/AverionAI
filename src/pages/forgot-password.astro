---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";

export const prerender = false;

let success = false;
let errors: string[] = [];

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = String(formData.get("email") || "").trim().toLowerCase();

  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errors.push("Email invalido.");
  }

  if (errors.length === 0) {
    try {
      const res = await fetch(`${Astro.url.origin}/api/auth/password-reset`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "request", email }),
      });
      const data = await res.json();

      if (data.success) {
        success = true;
      } else {
        errors.push(data.error || "Error al solicitar recuperacion.");
      }
    } catch {
      errors.push("Error de conexion. Intenta de nuevo.");
    }
  }
}
---

<BaseLayout
  title="Recuperar contraseña | AverionAI"
  description="Recupera el acceso a tu cuenta de AverionAI. Introduce tu email y te enviaremos un enlace de recuperacion."
>
  <main class="grid min-h-screen place-items-center bg-[#07070A] px-6 py-16">
    <section class="w-full max-w-md">
      <div class="premium-panel animated-border p-7 md:p-8">
        <BrandLogo label="AverionAI" markClass="h-8 w-8" textClass="text-sm text-white/70" />

        <div class="mt-10">
          <p class="text-xs uppercase tracking-[0.18em] text-cyan-200/75">
            Recuperacion
          </p>

          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">
            Recuperar contraseña
          </h1>

          <p class="mt-3 text-sm leading-relaxed text-white/50">
            Introduce tu email y te enviaremos un enlace para restablecer tu contraseña.
          </p>
        </div>

        {success && (
          <div class="mt-6 rounded-xl border border-emerald-300/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
            <p>Si el email existe, recibiras un enlace de recuperacion en breve.</p>
          </div>
        )}

        {errors.length > 0 && (
          <div class="mt-6 space-y-2 rounded-xl border border-red-300/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">
            {errors.map((err) => (
              <p>{err}</p>
            ))}
          </div>
        )}

        <form method="POST" class="mt-7 space-y-4" data-forgot-form>
          <label class="block space-y-2">
            <span class="text-sm text-white/65">Email</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="tu@email.com"
              class="input-premium w-full"
            />
          </label>

          <button class="btn-primary w-full py-3.5">
            Enviar enlace de recuperacion
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-white/40">
          ¿Recuerdas tu contraseña?{" "}
          <a href="/login" class="text-cyan-200 underline decoration-cyan-300/35 underline-offset-4 transition hover:text-white">
            Iniciar sesion
          </a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-forgot-form]");
      form?.addEventListener("submit", () => {
        const button = form.querySelector("button");
        if (button) {
          button.disabled = true;
          button.textContent = "Enviando...";
          button.classList.add("opacity-75");
        }
      });
    })();
  </script>
</BaseLayout>
