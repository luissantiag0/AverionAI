---
import BrandLogo from "./BrandLogo.astro";
import { SESSION_COOKIE } from "../lib/session";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = await getCurrentUser(token);
const isLoggedIn = !!user;
---

<header class="site-header sticky top-0 z-50 border-b border-white/10 bg-[#07070A]/72 backdrop-blur-xl transition-all duration-300 ease-in-out" data-site-header role="banner">
  <div class="site-header-inner container flex min-h-16 items-center justify-between gap-4 transition-all duration-300 ease-in-out">
    <BrandLogo markClass="h-8 w-8" textClass="text-lg" />

    <nav class="hidden items-center gap-7 text-sm md:flex md:flex-1 md:justify-center" aria-label="Navegacion principal">
      <a href="/pricing" data-track="nav_click" data-track-label="planes" class="text-white/55 transition hover:text-cyan-100">
        Planes
      </a>

      {!isLoggedIn && (
        <>
          <a href="/#systems" data-track="nav_click" data-track-label="sistemas" class="text-white/55 transition hover:text-cyan-100">
            Sistemas
          </a>
          <a href="/#technology" data-track="nav_click" data-track-label="tecnologia" class="text-white/55 transition hover:text-cyan-100">
            Tecnologia
          </a>
          <button
            type="button"
            data-open-lead-modal
            data-track="nav_click"
            data-track-label="contacto"
            class="text-white/55 transition hover:text-cyan-100"
          >
            Contacto
          </button>
        </>
      )}

      {isLoggedIn && (
        <>
          <a href="/dashboard" data-track="nav_click" data-track-label="dashboard" class="text-white/55 transition hover:text-cyan-100">
            Dashboard
          </a>
          <a href="/dashboard/settings" data-track="nav_click" data-track-label="cuenta" class="text-white/55 transition hover:text-cyan-100">
            Cuenta
          </a>
          <form method="POST" action="/logout" class="inline">
            <button type="submit" data-track="nav_click" data-track-label="salir" class="text-white/55 transition hover:text-cyan-100">
              Salir
            </button>
          </form>
        </>
      )}
    </nav>

    <div class="flex items-center gap-3">
      {!isLoggedIn && (
        <>
          <a href="/login" data-track="cta_click" data-track-label="nav_iniciar_sesion" class="btn-secondary px-4 py-2.5 text-sm hidden sm:inline-flex">Iniciar sesion</a>
          <a href="/register" data-track="cta_click" data-track-label="nav_empezar" class="btn-primary px-5 py-2.5 text-sm">Empezar ahora</a>
        </>
      )}
      {isLoggedIn && (
        <form method="POST" action="/logout" class="hidden md:block">
          <button class="btn-secondary px-4 py-2.5 text-sm">Salir</button>
        </form>
      )}
    </div>
  </div>

  <script is:inline>
    (() => {
      const header = document.querySelector("[data-site-header]");

      if (!header) return;

      const updateHeader = () => {
        header.classList.toggle("is-scrolled", window.scrollY > 8);
      };

      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
    })();
  </script>
</header>
