---
---

<div
  id="lead-capture-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lead-modal-title"
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
>
  <div
    id="lead-modal-backdrop"
    class="absolute inset-0 bg-black/70 opacity-0 backdrop-blur-xl transition-opacity duration-300"
  ></div>

  <div
    id="lead-modal-panel"
    class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto overflow-hidden rounded-2xl border border-white/10 bg-[#090C12]/95 shadow-[0_30px_90px_-35px_rgba(34,211,238,0.7)] ring-1 ring-white/[0.04] transition duration-300"
    style="transform: translateY(18px) scale(0.98); opacity: 0;"
  >
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-300/70 to-transparent"></div>
    <div id="lead-modal-form-state">
      <div class="border-b border-white/[0.08] px-6 py-5 md:px-8">
        <div class="flex items-start justify-between gap-5">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.18em] text-cyan-200/80">
              Analisis de operaciones
            </p>

            <h2 id="lead-modal-title" class="mt-3 text-2xl font-semibold tracking-tight text-white">
              Solicita tu analisis gratuito
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-white/55">
              Identificamos que procesos de tu negocio pueden automatizarse con IA y te entregamos un plan claro de implementacion.
            </p>
          </div>

          <button
            type="button"
            data-close-lead-modal
            aria-label="Cerrar formulario"
            class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[0.03] text-xl leading-none text-white/60 transition hover:border-white/25 hover:bg-white/10 hover:text-white"
          >
            ×
          </button>
        </div>
      </div>

      <form id="lead-capture-form" class="space-y-4 px-6 py-6 md:px-8" novalidate>
        <input type="hidden" id="lead-submitted-at" name="submittedAt" />

        <div class="hidden" aria-hidden="true">
          <label>
            Web
            <input tabindex="-1" autocomplete="off" name="companyWebsite" />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="space-y-2">
            <span class="text-sm text-white/70">Nombre completo *</span>
            <input
              name="fullName"
              autocomplete="name"
              required
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition placeholder:text-white/25 focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10"
              placeholder="Tu nombre"
            />
            <span class="lead-field-error hidden text-xs text-red-300" data-error-for="fullName"></span>
          </label>

          <label class="space-y-2">
            <span class="text-sm text-white/70">Email corporativo *</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              required
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition placeholder:text-white/25 focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10"
              placeholder="tu@empresa.com"
            />
            <span class="lead-field-error hidden text-xs text-red-300" data-error-for="email"></span>
          </label>
        </div>

        <label class="block space-y-2">
          <span class="text-sm text-white/70">Empresa *</span>
          <input
            name="companyName"
            autocomplete="organization"
            required
            class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition placeholder:text-white/25 focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10"
            placeholder="Nombre de tu empresa"
          />
          <span class="lead-field-error hidden text-xs text-red-300" data-error-for="companyName"></span>
        </label>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="space-y-2">
            <span class="text-sm text-white/70">Tamaño de empresa</span>
            <select
              name="companySize"
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10 appearance-none"
            >
              <option value="" class="bg-[#090C12]">Seleccionar</option>
              <option value="1-10" class="bg-[#090C12]">1-10 empleados</option>
              <option value="11-50" class="bg-[#090C12]">11-50 empleados</option>
              <option value="51-200" class="bg-[#090C12]">51-200 empleados</option>
              <option value="201-500" class="bg-[#090C12]">201-500 empleados</option>
              <option value="500+" class="bg-[#090C12]">500+ empleados</option>
            </select>
          </label>

          <label class="space-y-2">
            <span class="text-sm text-white/70">Leads mensuales estimados</span>
            <select
              name="leadVolume"
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10 appearance-none"
            >
              <option value="" class="bg-[#090C12]">Seleccionar</option>
              <option value="<50" class="bg-[#090C12]">Menos de 50</option>
              <option value="50-200" class="bg-[#090C12]">50-200</option>
              <option value="200-500" class="bg-[#090C12]">200-500</option>
              <option value="500-1000" class="bg-[#090C12]">500-1.000</option>
              <option value="1000+" class="bg-[#090C12]">1.000+</option>
            </select>
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="space-y-2">
            <span class="text-sm text-white/70">CRM actual</span>
            <select
              name="currentCRM"
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10 appearance-none"
            >
              <option value="" class="bg-[#090C12]">Seleccionar</option>
              <option value="ninguno" class="bg-[#090C12]">Ninguno / hojas de calculo</option>
              <option value="hubspot" class="bg-[#090C12]">HubSpot</option>
              <option value="salesforce" class="bg-[#090C12]">Salesforce</option>
              <option value="pipedrive" class="bg-[#090C12]">Pipedrive</option>
              <option value="zoho" class="bg-[#090C12]">Zoho CRM</option>
              <option value="otro" class="bg-[#090C12]">Otro</option>
            </select>
          </label>

          <label class="space-y-2">
            <span class="text-sm text-white/70">Presupuesto estimado</span>
            <select
              name="budget"
              class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10 appearance-none"
            >
              <option value="" class="bg-[#090C12]">Seleccionar</option>
              <option value="<500" class="bg-[#090C12]">Menos de 500€/mes</option>
              <option value="500-1000" class="bg-[#090C12]">500-1.000€/mes</option>
              <option value="1000-3000" class="bg-[#090C12]">1.000-3.000€/mes</option>
              <option value="3000+" class="bg-[#090C12]">3.000€+/mes</option>
              <option value="evaluando" class="bg-[#090C12]">Evaluando opciones</option>
            </select>
          </label>
        </div>

        <label class="block space-y-2">
          <span class="text-sm text-white/70">Mayor cuello de botella operativo</span>
          <select
            name="bottleneck"
            class="lead-input w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10 appearance-none"
          >
            <option value="" class="bg-[#090C12]">Seleccionar</option>
            <option value="respuesta-leads" class="bg-[#090C12]">Respuesta tarda a leads</option>
            <option value="cualificacion" class="bg-[#090C12]">Cualificacion manual de leads</option>
            <option value="seguimiento" class="bg-[#090C12]">Seguimiento de oportunidades</option>
            <option value="documentos" class="bg-[#090C12]">Generacion de propuestas/facturas</option>
            <option value="reporting" class="bg-[#090C12]">Reporting y metricas manuales</option>
            <option value="integracion" class="bg-[#090C12]">Integracion entre herramientas</option>
          </select>
        </label>

        <label class="block space-y-2">
          <span class="text-sm text-white/70">Qué necesitas automatizar</span>
          <textarea
            name="message"
            rows="3"
            class="lead-input w-full resize-none rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-white outline-none transition placeholder:text-white/25 focus:border-cyan-300/60 focus:ring-4 focus:ring-cyan-300/10"
            placeholder="Cuéntanos el proceso, herramienta o cuello de botella..."
          ></textarea>
          <span class="lead-field-error hidden text-xs text-red-300" data-error-for="message"></span>
        </label>

        <div
          id="lead-error-banner"
          class="hidden rounded-xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm text-red-200"
        >
          <p id="lead-error-message"></p>
        </div>

        <button
          id="lead-submit-btn"
          type="submit"
          data-track="lead_form_submit"
          data-track-label="modal_solicitar_analisis"
          class="group relative flex w-full items-center justify-center overflow-hidden rounded-xl bg-white px-6 py-3.5 font-semibold text-black shadow-[0_18px_55px_-26px_rgba(255,255,255,0.9)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_24px_70px_-24px_rgba(34,211,238,0.9)] active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-70"
        >
          <span class="absolute inset-0 translate-x-[-120%] bg-gradient-to-r from-transparent via-cyan-200/70 to-transparent transition duration-700 group-hover:translate-x-[120%]"></span>
          <span id="lead-submit-label" class="relative">Solicitar analisis gratuito</span>
          <span
            id="lead-submit-spinner"
            class="relative ml-3 hidden h-4 w-4 animate-spin rounded-full border-2 border-black/20 border-t-black"
          ></span>
        </button>

        <p class="text-center text-xs text-white/35">
          Respuesta en menos de 24h · Sin compromiso · Datos protegidos RGPD
        </p>
      </form>
    </div>

    <div id="lead-modal-success-state" class="hidden px-8 py-12 text-center">
      <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-emerald-300/25 bg-emerald-300/10 text-emerald-200">
        ✓
      </div>

      <h3 class="mt-6 text-2xl font-semibold text-white">
        Solicitud recibida
      </h3>

      <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-white/60">
        Nuestro equipo analizara tu operativa y te contactara en menos de 24 horas con un plan de automatizacion personalizado.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/pricing"
          data-track="cta_click"
          data-track-label="success_ver_planes"
          class="btn-primary text-sm"
        >
          Ver planes disponibles
        </a>

        <button
          type="button"
          data-close-lead-modal
          class="rounded-xl border border-white/10 bg-white/[0.04] px-5 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  if (window.__leadModalInitialized) return;
  window.__leadModalInitialized = true;

  const modal = document.getElementById("lead-capture-modal");
  const form = document.getElementById("lead-capture-form");
  const panel = document.getElementById("lead-modal-panel");
  const backdrop = document.getElementById("lead-modal-backdrop");
  const submitBtn = document.getElementById("lead-submit-btn");
  const submitLabel = document.getElementById("lead-submit-label");
  const submitSpinner = document.getElementById("lead-submit-spinner");
  const formState = document.getElementById("lead-modal-form-state");
  const successState = document.getElementById("lead-modal-success-state");
  const errorBanner = document.getElementById("lead-error-banner");
  const errorMessage = document.getElementById("lead-error-message");
  const submittedAtInput = document.getElementById("lead-submitted-at");

  if (!modal || !form || !panel || !backdrop) return;

  let isLoading = false;
  let lastFocusedElement = null;

  const setSubmittedAt = () => {
    if (submittedAtInput) submittedAtInput.value = String(Date.now());
  };

  const openModal = () => {
    lastFocusedElement = document.activeElement;
    hideError();
    clearErrors();
    formState.classList.remove("hidden");
    successState.classList.add("hidden");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";

    requestAnimationFrame(() => {
      backdrop.style.opacity = "1";
      panel.style.opacity = "1";
      panel.style.transform = "translateY(0) scale(1)";
      form.querySelector("input[name='fullName']")?.focus();
    });
  };

  const closeModal = () => {
    if (isLoading) return;
    backdrop.style.opacity = "0";
    panel.style.opacity = "0";
    panel.style.transform = "translateY(18px) scale(0.98)";

    window.setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocusedElement?.focus?.();
    }, 220);
  };

  const setLoading = (state) => {
    isLoading = state;
    submitBtn.disabled = state;
    submitLabel.textContent = state ? "Enviando..." : "Solicitar analisis gratuito";
    submitSpinner.classList.toggle("hidden", !state);
  };

  function showError(message) {
    errorMessage.textContent = message;
    errorBanner.classList.remove("hidden");
  }

  function hideError() {
    errorBanner.classList.add("hidden");
    errorMessage.textContent = "";
  }

  function clearErrors() {
    form.querySelectorAll(".lead-field-error").forEach((item) => {
      item.textContent = "";
      item.classList.add("hidden");
    });

    form.querySelectorAll(".lead-input").forEach((item) => {
      item.classList.remove("border-red-300/60", "ring-4", "ring-red-300/10");
    });
  }

  function setFieldError(name, message) {
    const field = form.querySelector(`[name="${name}"]`);
    const target = form.querySelector(`[data-error-for="${name}"]`);

    if (field) {
      field.classList.add("border-red-300/60", "ring-4", "ring-red-300/10");
    }

    if (target) {
      target.textContent = message;
      target.classList.remove("hidden");
    }
  }

  const validate = (values) => {
    const errors = {};
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!values.fullName) errors.fullName = "Indica tu nombre.";
    if (!values.email) errors.email = "Indica tu email.";
    if (values.email && !emailPattern.test(values.email)) errors.email = "Introduce un email valido.";
    if (!values.companyName) errors.companyName = "Indica tu empresa.";

    return errors;
  };

  document.addEventListener("click", (event) => {
    const openTrigger = event.target.closest("[data-open-lead-modal]");
    const closeTrigger = event.target.closest("[data-close-lead-modal]");

    if (openTrigger) {
      event.preventDefault();
      event.stopImmediatePropagation();
      openModal();
      return;
    }

    if (closeTrigger) {
      event.preventDefault();
      closeModal();
    }
  });

  backdrop.addEventListener("click", closeModal);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isLoading) return;

    clearErrors();
    hideError();

    const formData = new FormData(form);
    const values = {
      fullName: String(formData.get("fullName") || "").trim(),
      email: String(formData.get("email") || "").trim(),
      companyName: String(formData.get("companyName") || "").trim(),
      message: String(formData.get("message") || "").trim(),
      companySize: String(formData.get("companySize") || ""),
      leadVolume: String(formData.get("leadVolume") || ""),
      currentCRM: String(formData.get("currentCRM") || ""),
      budget: String(formData.get("budget") || ""),
      bottleneck: String(formData.get("bottleneck") || ""),
      companyWebsite: String(formData.get("companyWebsite") || "").trim(),
      submittedAt: Number(formData.get("submittedAt") || Date.now()),
    };

    const errors = validate(values);
    const errorEntries = Object.entries(errors);

    if (errorEntries.length) {
      errorEntries.forEach(([name, message]) => setFieldError(name, message));
      showError("Revisa los campos marcados.");
      return;
    }

    setLoading(true);

    try {
      const response = await fetch("/api/leads/create", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
        },
        body: JSON.stringify(values),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || result.success === false) {
        throw new Error(result.message || "No se pudo enviar el formulario.");
      }

      form.reset();
      formState.classList.add("hidden");
      successState.classList.remove("hidden");
    } catch (error) {
      showError(error.message || "Error enviando el formulario. Intentalo de nuevo.");
    } finally {
      setLoading(false);
      setSubmittedAt();
    }
  });
})();
</script>
